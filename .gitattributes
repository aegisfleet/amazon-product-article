* text=auto

# Force LF for source files and configurations to avoid cross-OS line ending issues
*.sh text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# Disable line ending normalization for huge product cache JSON to prevent git mmap/Bus errors
data/cache/paapi-product-cache.json -text

