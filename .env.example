# Amazon Creators API Configuration
AMAZON_CREATORS_APPLICATION_ID=your_application_id_here
AMAZON_CREATORS_CREDENTIAL_ID=your_credential_id_here
AMAZON_CREATORS_CREDENTIAL_SECRET=your_credential_secret_here
AMAZON_PARTNER_TAG=your_amazon_partner_tag_here

# Creators API Rate Limiting (optional - defaults shown)
# Adjust these if you encounter rate limit errors (429)
CREATORS_API_REQUESTS_PER_SECOND=0.8  # Conservative: 0.8 requests per second (default: 0.8)
CREATORS_API_BURST_LIMIT=5             # Maximum burst requests (default: 5)
CREATORS_API_RETRY_DELAY=1000          # Initial retry delay in ms (default: 1000)
CREATORS_API_MAX_RETRIES=5             # Maximum retry attempts (default: 5)

# Jules API Configuration
JULES_API_KEY=your_jules_api_key_here
JULES_SOURCE=sources/github/owner/repo
JULES_STARTING_BRANCH=main

# GitHub Configuration
GITHUB_TOKEN=your_github_token_here
GITHUB_REPOSITORY=your_username/your_repository
GITHUB_BRANCH=main

# System Configuration
LOG_LEVEL=info
RETRY_ATTEMPTS=3
RETRY_DELAY=1000
MAX_CONCURRENT_REQUESTS=5

# Product Search Configuration
PRODUCT_CATEGORIES=Electronics,Home,Sports,Books,Toys
MAX_RESULTS_PER_CATEGORY=10
SEARCH_KEYWORDS=best,top,review,recommended

# Article Generation Configuration
ARTICLE_OUTPUT_PATH=./articles
MIN_WORD_COUNT=2000
INCLUDE_IMAGES=true