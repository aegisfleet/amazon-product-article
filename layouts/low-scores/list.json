{{- /* 低スコアページ絞り込み用データセット（従来は HTML 埋め込みだったものを外部 JSON 化） */ -}}
{{- $articles := where .Site.RegularPages "Section" "articles" -}}
{{- $targets := slice -}}
{{- range $articles -}}
  {{- $score := .Params.score | default 0 -}}
  {{- if and (ge $score 1) (le $score 50) -}}
    {{- $targets = $targets | append . -}}
  {{- end -}}
{{- end -}}
{{- partial "product-dataset.html" (dict "pages" $targets) | jsonify -}}
