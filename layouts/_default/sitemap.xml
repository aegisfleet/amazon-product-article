{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- range .Data.Pages }}
  {{- if not .Params.noindex }}
  {{- /* Determine priority and changeFreq based on page type */ -}}
  {{- $priority := 0.5 -}}
  {{- $changeFreq := "monthly" -}}
  {{- if .IsHome -}}
    {{- $priority = 1.0 -}}
    {{- $changeFreq = "daily" -}}
  {{- else if eq .Section "parent-category" -}}
    {{- $priority = 0.8 -}}
    {{- $changeFreq = "weekly" -}}
  {{- else if eq .Type "categories" -}}
    {{- $priority = 0.8 -}}
    {{- $changeFreq = "weekly" -}}
  {{- else if eq .Section "recommendations" -}}
    {{- $priority = 0.7 -}}
    {{- $changeFreq = "daily" -}}
  {{- else if eq .Section "brand" -}}
    {{- $priority = 0.6 -}}
    {{- $changeFreq = "weekly" -}}
  {{- else if eq .Section "articles" -}}
    {{- /* Article pages: priority based on score */ -}}
    {{- $score := .Params.score | default 0 -}}
    {{- if ge $score 80 -}}
      {{- $priority = 0.7 -}}
      {{- $changeFreq = "weekly" -}}
    {{- else if ge $score 60 -}}
      {{- $priority = 0.5 -}}
      {{- $changeFreq = "monthly" -}}
    {{- else -}}
      {{- $priority = 0.3 -}}
      {{- $changeFreq = "monthly" -}}
    {{- end -}}
  {{- end }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>
    {{- end }}
    <changefreq>{{ $changeFreq }}</changefreq>
    <priority>{{ printf "%.1f" $priority }}</priority>
  </url>
  {{- end }}
  {{- end }}
</urlset>
