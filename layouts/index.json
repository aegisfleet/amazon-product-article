{{- $.Scratch.Add "index" slice -}}
{{- $taxonomy := index site.Data "taxonomy-v2" -}}
{{- $parentNamesBySlug := dict -}}
{{- $parentNamesByChild := dict -}}
{{- with $taxonomy -}}
  {{- range .parents -}}
    {{- $parentNamesBySlug = merge $parentNamesBySlug (dict .slug .name) -}}
    {{- $pName := .name -}}
    {{- range .children -}}
      {{- $parentNamesByChild = merge $parentNamesByChild (dict .name $pName) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- range where .Site.RegularPages "Section" "articles" -}}
  {{- $image := "" -}}
  {{- with .Params.images -}}
    {{- $image = index . 0 | relURL -}}
  {{- end -}}
  {{- $product_name := .Params.product_name | default .Title -}}
  {{- $summary := .Params.description | default (.Summary | plainify | truncate 200) -}}
  {{- $spec_text := "" -}}
  {{- with .Params.specs -}}
    {{- range $key, $value := . -}}
      {{- if (reflect.IsSlice $value) -}}
        {{- $spec_text = printf "%s %s:%s" $spec_text $key (delimit $value " ") -}}
      {{- else -}}
        {{- $spec_text = printf "%s %s:%s" $spec_text $key $value -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
  {{- $priceText := .Params.price | default "" | string -}}
  {{- $priceNumericText := replaceRE "[^0-9.]" "" $priceText -}}
  {{- $priceValue := 0 -}}
  {{- if gt (len $priceNumericText) 0 -}}
    {{- $priceBase := float $priceNumericText -}}
    {{- if in $priceText "万" -}}
      {{- $priceValue = mul $priceBase 10000 -}}
    {{- else if in $priceText "千" -}}
      {{- $priceValue = mul $priceBase 1000 -}}
    {{- else -}}
      {{- $priceValue = $priceBase -}}
    {{- end -}}
  {{- end -}}
  {{- $specsJson := partial "product-specs-json.html" .Params.specs -}}
  {{- $specsHtml := cond (not (not .Params.specs)) (partial "product-spec-tags.html" (dict "specs" .Params.specs "tagClass" "card-spec-tag")) "" -}}
  {{- $categoryUrl := "" -}}
  {{- $categories := .GetTerms "categories" -}}
  {{- if $categories -}}
    {{- $categoryUrl = (index $categories 0).RelPermalink -}}
  {{- else if .Params.category -}}
    {{- with .Site.GetPage (printf "/categories/%s" (.Params.category | urlize)) -}}
      {{- $categoryUrl = .RelPermalink -}}
    {{- end -}}
  {{- end -}}
  {{- $firstCat := "" -}}
  {{- if .Params.categories -}}{{- $firstCat = index .Params.categories 0 -}}{{- else if .Params.category -}}{{- $firstCat = .Params.category -}}{{- end -}}
  {{- $categoryParent := "" -}}
  {{- if $firstCat -}}
    {{- $categoryParent = index $parentNamesByChild $firstCat | default "" -}}
  {{- end -}}
  {{- if not $categoryParent -}}
    {{- with .Params.category_parent -}}
      {{- $categoryParent = index $parentNamesBySlug . | default "" -}}
    {{- end -}}
  {{- end -}}
  {{- $dict := dict
      "title" $product_name
      "permalink" .RelPermalink
      "category_parent" $categoryParent
      "categories" .Params.categories
      "amazon_category" (.Params.amazon_category | default "")
      "category_url" $categoryUrl
      "summary" $summary
      "image" $image
      "price" .Params.price
      "price_value" $priceValue
      "investigated_price" (.Params.investigated_price | default "")
      "score" .Params.score
      "last_investigated" .Params.last_investigated
      "specs" $spec_text
      "asin" .Params.asin
      "parent_asin" (.Params.parent_asin | default "")
      "affiliate_url" .Params.affiliate_url
      "savings_percentage" .Params.savings_percentage
      "deal_badge" (.Params.deal_badge | default "")
      "deal_access_type" (.Params.deal_access_type | default "")
      "specs_json" $specsJson
      "specs_html" $specsHtml
      "availability" (.Params.availability | default "")
      "in_stock" (partial "utils-in-stock.html" .)
    -}}
  {{- $.Scratch.Add "index" $dict -}}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}
