{
  "name": "amazon-product-research-system",
  "version": "1.0.0",
  "description": "Amazon Creators APIとGoogle Julesを活用した商品調査記事の自動生成・公開システム",
  "main": "dist/index.js",
  "scripts": {
    "sanitize:frontmatter": "ts-node src/scripts/sanitize-frontmatter.ts",
    "prebuild:hugo": "ts-node src/scripts/enhance-categories.ts",
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "server": "hugo server",
    "server:dev": "hugo server --config config.toml,hugo.dev.toml --templateMetrics --gc --noHTTPCache",
    "server:fast": "hugo server --templateMetrics --disableFastRender --gc --noHTTPCache",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rimraf dist",
    "search:products": "ts-node src/scripts/product-search-cli.ts",
    "investigate": "ts-node src/scripts/jules-investigation-cli.ts",
    "investigate:recommendations": "ts-node src/scripts/today-recommendation-cli.ts",
    "generate:articles": "ts-node src/scripts/article-generation-cli.ts",
    "merge:pr": "ts-node src/scripts/pr-merge-cli.ts",
    "organize:categories": "ts-node src/scripts/organize-categories-cli.ts",
    "sort:categories": "ts-node src/scripts/sort-categories.ts",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write ."
  },
  "keywords": [
    "amazon",
    "product-research",
    "jules-api",
    "github-actions",
    "affiliate"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "eslint": "^10.3.0",
    "fast-check": "^4.7.0",
    "globals": "^17.5.0",
    "jest": "^30.4.2",
    "paapi5-nodejs-sdk": "^1.1.0",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.59.2"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "axios": "^1.16.0",
    "dotenv": "^17.4.2",
    "fuse.js": "^7.3.0",
    "gray-matter": "^4.0.3",
    "jest-util": "^30.4.1",
    "js-yaml": "^4.1.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "crypto-js": "^4.2.0",
    "test-exclude": {
      "minimatch": "3.1.5"
    }
  }
}
