{
  "name": "amazon-product-research-system",
  "version": "1.0.0",
  "description": "Amazon Creators APIとAntigravity CLIを活用した商品調査記事の自動生成・公開システム",
  "main": "dist/index.js",
  "scripts": {
    "sanitize:frontmatter": "ts-node src/scripts/sanitize-frontmatter.ts",
    "generate:summary": "ts-node src/scripts/generate-products-summary.ts",
    "generate:pickup-pool": "ts-node src/scripts/generate-pickup-pool.ts",
    "prebuild:hugo": "ts-node src/scripts/enhance-categories.ts && ts-node src/scripts/extract-price-drops.ts && ts-node src/scripts/generate-products-summary.ts && ts-node src/scripts/generate-pickup-pool.ts",
    "build": "tsc",
    "build:hugo": "hugo --minify",
    "dev": "ts-node src/index.ts",
    "server": "hugo server",
    "server:dev": "hugo server --config config.toml,hugo.dev.toml --templateMetrics --gc --noHTTPCache",
    "server:fast": "hugo server --templateMetrics --disableFastRender --gc --noHTTPCache",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rimraf dist",
    "search:products": "ts-node src/scripts/product-search-cli.ts",
    "investigate": "ts-node src/scripts/investigation-cli.ts",
    "investigate:recommendations": "ts-node src/scripts/today-recommendation-cli.ts",
    "investigate:price-discrepancy": "ts-node src/scripts/investigate-price-discrepancy-cli.ts",
    "investigate:uncovered-deals": "ts-node src/scripts/investigate-uncovered-deals-cli.ts",
    "investigate:user-requests": "ts-node src/scripts/investigate-user-requests-cli.ts",
    "extract:sale-candidates": "ts-node src/scripts/extract-sale-candidates.ts",
    "extract:price-drops": "ts-node src/scripts/extract-price-drops.ts",
    "generate:articles": "ts-node src/scripts/article-generation-cli.ts",
    "merge:pr": "ts-node src/scripts/pr-merge-cli.ts",
    "audit:dead": "ts-node src/scripts/maintenance/prune-dead-products.ts --audit --scope stale --stale-days 90",
    "prune:dead": "ts-node src/scripts/maintenance/prune-dead-products.ts --prune --scope stale --stale-days 90",
    "audit:score-discrepancy": "ts-node src/scripts/maintenance/find-score-discrepancy.ts",
    "reset:cache-timestamp": "ts-node src/scripts/maintenance/reset-cache-timestamp.ts",
    "reset:category-cache": "ts-node src/scripts/maintenance/reset-category-cache.ts",
    "sync:variations": "ts-node src/scripts/maintenance/sync-variations.ts",
    "clean:outdated-deal-badges": "ts-node src/scripts/maintenance/clear-outdated-deal-badges.ts --execute --include-all-events",
    "set:gemini-key": "ts-node src/scripts/maintenance/set-gemini-key.ts",
    "verify:gemini-key": "ts-node src/scripts/maintenance/verify-gemini-key.ts",
    "classify:products": "ts-node src/scripts/maintenance/classify-products-cli.ts",
    "sync:product-categories": "ts-node src/scripts/maintenance/sync-product-categories.ts",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write ."
  },
  "keywords": [
    "amazon",
    "product-research",
    "antigravity-cli",
    "github-actions",
    "affiliate"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@eslint/js": "^10.0.1",
    "@types/google-apps-script": "^2.0.12",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "hugo-extended": "^0.169.0",
    "jest": "^30.5.2",
    "paapi5-nodejs-sdk": "^1.1.0",
    "rimraf": "^6.1.4",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "dependencies": {
    "@11ty/gray-matter": "^3.0.0",
    "@octokit/rest": "^22.0.1",
    "axios": "^1.21.0",
    "dotenv": "^18.0.9",
    "fuse.js": "^7.5.0",
    "jest-util": "^30.5.1",
    "js-yaml": "5.5.0",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "overrides": {
      "crypto-js": "^4.2.0",
      "qs": "^6.16.1",
      "@babel/core": "^7.29.6",
      "js-yaml": "5.5.0",
      "form-data": "^2.5.6",
      "browserslist": "^4.28.7",
      "adm-zip": "^0.6.1",
      "handlebars": "^4.7.10",
      "follow-redirects": "^1.16.2",
      "minimatch": "^11.0.1"
    },
    "onlyBuiltDependencies": [
      "unrs-resolver",
      "hugo-extended"
    ]
  },
  "packageManager": "pnpm@10.5.2"
}
