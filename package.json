{
  "name": "amazon-product-research-system",
  "version": "1.0.0",
  "description": "Amazon Creators APIとGoogle Julesを活用した商品調査記事の自動生成・公開システム",
  "main": "dist/index.js",
  "scripts": {
    "sanitize:frontmatter": "ts-node src/scripts/sanitize-frontmatter.ts",
    "prebuild:hugo": "mkdir -p static/data && cp data/categorygroups.json static/data/",
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rimraf dist",
    "search:products": "ts-node src/scripts/product-search-cli.ts",
    "investigate": "ts-node src/scripts/jules-investigation-cli.ts",
    "generate:articles": "ts-node src/scripts/article-generation-cli.ts",
    "merge:pr": "ts-node src/scripts/pr-merge-cli.ts",
    "organize:categories": "ts-node src/scripts/organize-categories-cli.ts",
    "sort:categories": "ts-node src/scripts/sort-categories.ts",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write ."
  },
  "keywords": [
    "amazon",
    "product-research",
    "jules-api",
    "github-actions",
    "affiliate"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.0",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "eslint": "^10.0.1",
    "fast-check": "^4.5.3",
    "globals": "^17.3.0",
    "jest": "^30.2.0",
    "paapi5-nodejs-sdk": "^1.1.0",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "8.56.1"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "axios": "^1.13.5",
    "dotenv": "^17.3.1",
    "fuse.js": "^7.1.0",
    "googleapis": "^171.4.0",
    "xml2js": "^0.6.2",
    "zod": "^4.3.6"
  },
  "overrides": {
    "crypto-js": "^4.2.0",
    "test-exclude": {
      "minimatch": "3.1.5"
    }
  }
}
